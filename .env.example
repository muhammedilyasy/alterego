# alterego configuration — copy to .env and fill in, or export directly.

# Provider: "openai" = any OpenAI-compatible API, "anthropic" = Anthropic Messages API,
# "claude-code" = think through the Claude Code CLI (uses your Claude subscription
# sign-in instead of an API key — install @anthropic-ai/claude-code and run `claude` once)
LLM_PROVIDER=openai

# Claude Code binary name/path (claude-code provider only)
# CLAUDE_CODE_BIN=claude

# API key (leave empty for local servers like Ollama / LM Studio)
LLM_API_KEY=

# Base URL of the API
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Together:    https://api.together.xyz/v1
#   Groq:        https://api.groq.com/openai/v1
#   Ollama:      http://localhost:11434/v1
#   LM Studio:   http://localhost:1234/v1
#   Anthropic:   https://api.anthropic.com
LLM_BASE_URL=https://api.openai.com/v1

# Model name, e.g. gpt-4o-mini / claude-sonnet-4-5 / llama3.1 / deepseek/deepseek-chat
LLM_MODEL=gpt-4o-mini

# Where the agent keeps its persona, memory, skills, sessions and outbox
AGENT_HOME=~/.alterego

# Tool approvals: ask (prompt in chat, deny when non-interactive) | auto | deny
AGENT_APPROVAL_MODE=ask

# Max tool-calling steps per turn
AGENT_MAX_STEPS=25
